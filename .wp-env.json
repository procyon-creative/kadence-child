{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "themes": [
    "."
  ],
  "mappings": {
    "wp-content/themes/kadence": "https://downloads.wordpress.org/theme/kadence.latest-stable.zip"
  },
  "lifecycleScripts": {
    "afterStart": "npm run composer -- install --no-interaction && npm run wp -- theme activate kadence-child"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true
  }
}
